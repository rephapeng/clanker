FROM golang:1.25-alpine AS build

RUN apk add --no-cache ca-certificates git
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# -mod=mod forces module-aware mode and ignores any `vendor/` directory that
# happens to exist at the repo root (we use vendor/hermes-agent for the
# Hermes Agent Python subprocess bridge, which is not a Go vendored deps dir).
RUN CGO_ENABLED=0 go build -mod=mod -trimpath -ldflags="-s -w" -o /out/clanker ./main.go

FROM alpine:3.22

RUN apk add --no-cache ca-certificates curl git openssh-client
COPY --from=build /out/clanker /usr/local/bin/clanker

ENTRYPOINT ["clanker"]
CMD ["sre", "run", "--sre", "--target", "docker"]
